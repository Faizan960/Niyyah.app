<?xml version="1.0" encoding="utf-8"?>
<!-- BM-011 — misbaha (prayer beads) glyph for the Azkar quick action.
     Stroke-only so the call site tint controls the final color. A ring of
     beads over a short tassel and a terminal bead. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Bead loop -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:fillColor="#00000000"
        android:pathData="M12,3.5
            C16,3.5 19,6.5 19,10
            C19,13.5 16,15.5 12,15.5
            C8,15.5 5,13.5 5,10
            C5,6.5 8,3.5 12,3.5 Z"
        android:strokeLineCap="round" />

    <!-- Tassel -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:fillColor="#00000000"
        android:pathData="M12,15.5 L12,19"
        android:strokeLineCap="round" />

    <!-- Terminal bead -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:fillColor="#00000000"
        android:pathData="M12,20.6
            m-1.4,0 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0" />
</vector>
